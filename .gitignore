# Runtime folders: keep each folder's index.php, ignore what the app writes there
data/cache/*
!data/cache/index.php
backup/*
!backup/index.php
public/uploads/*
!public/uploads/index.php
public/temporary/*
!public/temporary/index.php

# Application and scheduled job logs
data/logs/*
!data/logs/index.php

# Written by bin/upgrade.sh on each deploy
VERSION.txt
