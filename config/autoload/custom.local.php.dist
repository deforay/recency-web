    ],
    'email' => [
        'host' => 'smtp.example.org',
        'config' => [
            'port' => 587,
            'username' => '',
            'password' => '',
            'ssl' => 'tls',
            'auth' => 'login'
        ],
    ],
    // The InteLIS API token Recency sends with its requests to InteLIS
