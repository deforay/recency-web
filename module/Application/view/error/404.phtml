<?php

/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 */

$this->layout()->pageTitle = 'Page not found';
?>
<h1>Page not found</h1>
<p>The page does not exist or has moved. Check the address, or start again from the home page.</p>
<?php if (!empty($this->reason)) : ?>
    <details open>
        <summary>Developer details</summary>
        <p>Reason: <code><?= $this->escapeHtml($this->reason) ?></code></p>
        <?php if (!empty($this->controller)) : ?>
            <p>Controller: <code><?= $this->escapeHtml($this->controller) ?></code></p>
        <?php endif; ?>
    </details>
<?php endif; ?>
<?= $this->partial('error/_details', [
    'display_exceptions' => $this->display_exceptions ?? false,
    'exception' => $this->exception ?? null,
]) ?>
