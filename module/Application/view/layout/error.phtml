<?php

/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 *
 * Layout for error pages (403, 404, 500). It reads no session and queries no
 * database, so it still renders when the error came from the database.
 * Module::onBootstrap sets it on every dispatch or render error.
 */

$statusCode = (int) ($this->statusCode ?? 500);
$pageTitle = $this->pageTitle ?? 'Something went wrong';
$reference = $this->reference ?? null;
$base = rtrim($this->basePath(), '/');
?>
